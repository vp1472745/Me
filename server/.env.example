# ==============================================================================
# SERVER ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy these variable names into your Render.com Dashboard:
# Render Dashboard -> Your Web Service -> Environment -> Add Environment Variables
# ==============================================================================

# 1. Server Environment
NODE_ENV=production
PORT=5000

# 2. Database Connection (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/myapp?retryWrites=true&w=majority

# 3. JWT Security
JWT_SECRET=your_jwt_secret_key_here

# 4. Email Configuration (REQUIRED FOR SENDING OTP)
# ==============================================================================
# OPTION A (RECOMMENDED FOR RENDER FREE TIER): Resend HTTPS API (Port 443)
# Render Free Tier blocks SMTP ports (25, 465, 587).
# Get a 100% Free API Key in 30 seconds at: https://resend.com
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=The Wedding Sedding <onboarding@resend.dev>

# OPTION B (ALTERNATIVE HTTPS API): Brevo (Sendinblue) HTTPS API (Port 443)
# Get a 100% Free API Key (300 emails/day) at: https://brevo.com
# BREVO_API_KEY=your_brevo_api_key_here

# OPTION C (SMTP FOR LOCAL / VPS / PAID RENDER):
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_google_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

# 5. Client & Server URLs
PROD_CLIENT_URL=https://me-lyart-xi.vercel.app
PROD_SERVER_URL=https://me-vp02.onrender.com
CLIENT_URL=https://me-lyart-xi.vercel.app
SERVER_URL=https://me-vp02.onrender.com

# 6. Google OAuth & Drive Integration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://me-vp02.onrender.com/api/google/callback
PROD_GOOGLE_REDIRECT_URI=https://me-vp02.onrender.com/api/google/callback

# 7. Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
